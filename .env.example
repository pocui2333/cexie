# ==============================================================================
# 侧写 (Cexie) - 环境变量配置示例 (可选)
# 默认情况下，系统采用内置高情商离线启发式规则引擎 (完全免配置、零成本、即开即用)
# 如需接入商业大模型 (DeepSeek / OpenAI / Moonshot 等)，请复制本文件为 .env 并填入 Key
# ==============================================================================

# LLM API 配置 (支持 OpenAI 兼容格式)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 服务端口与窗口尺寸 (默认无需修改)
PORT=8765
HOST=127.0.0.1
