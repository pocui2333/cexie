# ==============================================================================
# 侧写 (Cexie) - 环境变量配置示例 (可选)
# 默认情况下，系统采用内置高情商离线启发式规则引擎 (完全免配置、零成本、即开即用)
# 如需接入商业大模型 (DeepSeek / OpenAI / Moonshot 等)，请复制本文件为 .env 并填入 Key
# ==============================================================================

# LLM API 配置 (支持 OpenAI 兼容格式)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 服务端口 (默认无需修改；服务固定只监听 127.0.0.1)
PORT=8765

# 日志级别 (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO

# 可选：图片气泡描述所用的多模态模型 (需支持图片输入，如 gpt-4o-mini / qwen-vl-plus)
# 留空则仅使用 macOS 本地 Vision 做粗分类，聊天截图不会上传
LLM_VISION_MODEL=
